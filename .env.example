# --- Datenbank ---
POSTGRES_USER=agt
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=agt
DATABASE_URL=postgresql://agt:bitte-aendern@db:5432/agt

# --- App ---
# Welches Image aus ghcr.io/siliconserver/agent verwendet wird:
# latest = neuestes Release, main = Stand von main, oder feste Version wie 2.0
AGENT_TAG=latest

# Port, unter dem AGENT auf dem Server erreichbar ist (http://<server>:<Port>)
AGENT_PORT=8085

# Zeitzone für Zeitplan (Tauglichkeitsprüfung, Mails, Backups)
TZ=Europe/Berlin

# Langer, zufälliger String für Session-Cookies (z.B. `openssl rand -hex 32`)
SECRET_KEY=bitte-aendern-zu-einem-langen-zufallsstring

# Erst-Admin, wird beim ersten Start automatisch angelegt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern

# Vorbelegung für den Empfänger des wöchentlichen Reports.
# Kann danach in der Weboberfläche unter Einstellungen geändert werden.
ADMIN_EMAIL=wehrleitung@beispiel.de

# --- SMTP (für G26-Erinnerungen, Belastungsübungs-Mails und Wochenreport) ---
SMTP_HOST=mail.beispiel.de
SMTP_PORT=587
SMTP_USER=user@beispiel.de
SMTP_PASSWORD=geheim
SMTP_FROM=agent@beispiel.de
SMTP_USE_TLS=true

# --- Rechtliches (optional) ---
# Links im Fußbereich jeder Seite. Leer lassen, dann wird der Link nicht angezeigt.
IMPRESSUM_URL=
DATENSCHUTZ_URL=
